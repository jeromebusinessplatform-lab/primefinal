rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /config/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /couriers/{courierId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /customers/{customerId} {
      allow create: if isSignedIn() && request.auth.uid == customerId;
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == customerId);
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == customerId);
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if isSignedIn() && request.resource.data.telegramUserId == request.auth.uid;
      allow read: if isAdmin() || (isSignedIn() && resource.data.telegramUserId == request.auth.uid);
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.telegramUserId == request.auth.uid &&
        request.resource.data.telegramUserId == resource.data.telegramUserId &&
        request.resource.data.orderStatus == resource.data.orderStatus
      );
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
